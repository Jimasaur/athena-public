# Athena local development settings.
#
# Copy to .env or enter these in /admin/app_settings. AppSetting values stored
# in the database take precedence over environment values.

# Local app surface
PORT=3001
PUBLIC_BASE_URL=https://YOUR_PUBLIC_BASE_URL
ATHENA_PUBLIC_DEMO_MODE=false

# Admin access. Leave blank only for a local dev console.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_AUTH_REQUIRED=false
ATHENA_PROXY_AUTH_SECRET=

# OpenAI Realtime voice path
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_TWILIO_TRANSCRIPTION_ENABLED=false
OPENAI_REALTIME_INPUT_NOISE_REDUCTION=near_field
OPENAI_REALTIME_TURN_DETECTION_TYPE=server_vad
OPENAI_REALTIME_VAD_THRESHOLD=0.65
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=500
OPENAI_REALTIME_VAD_IDLE_TIMEOUT_MS=6000
OPENAI_REALTIME_SEMANTIC_EAGERNESS=auto
OPENAI_REALTIME_CREATE_RESPONSE=true
OPENAI_REALTIME_INTERRUPT_RESPONSE=false
OPENAI_REALTIME_INTERRUPT_GRACE_MS=2500
OPENAI_REALTIME_SESSION_OVERRIDES_JSON=
ATHENA_INTERNAL_BASE_URL=
ATHENA_TOOL_SECRET=
ATHENA_TOOL_SECRET_REQUIRED=false
ATHENA_PHONE_NUMBER=+15551234567

# Twilio voice and SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Keep false for local smoke tests. Set true before exposing a live public webhook.
TWILIO_VERIFY_WEBHOOK_SIGNATURES=true
TWILIO_SMS_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
VOICEBOT_TWILIO_FROM_NUMBER=
TWILIO_ALLOWED_CALLERS=

# Live web search sidecar
BRAVE_SEARCH_API_KEY=

# Local OpenClaw sidecar
OPENCLAW_CLI=openclaw
OPENCLAW_PROFILE=default
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT_SEC=120
OPENCLAW_DEFAULT_SESSION_ID=athena-openclaw
OPENCLAW_DEFAULT_THINKING=medium

# Gemma Mail approval flow
GEMMA_MAIL_OPENCLAW_PROFILE=gemma4
GEMMA_MAIL_OPENCLAW_AGENT=mail
GEMMA_MAIL_OPENCLAW_SESSION_ID=athena-gemma-mail
GEMMA_MAIL_OPENCLAW_THINKING=medium
GEMMA_MAIL_APPROVAL_CHANNEL=discord
GEMMA_MAIL_APPROVAL_TARGET=channel:YOUR_GEMMA_MAIL_CHANNEL_ID
GEMMA_MAIL_APPROVAL_SESSION_ID=athena-gemma-mail-approvals
GEMMA_MAIL_GMAIL_ACCOUNT=
GEMMA_MAIL_DEFAULT_RECIPIENT=

# Dedicated Athena idea and approval Discord channel.
ATHENA_CALLS_DISCORD_WEBHOOK_URL=
ATHENA_CALLS_DISCORD_USERNAME=Athena
ATHENA_CALLS_DISCORD_CHANNEL_LABEL=Athena Calls
ATHENA_IDEAS_DISCORD_WEBHOOK_URL=
ATHENA_IDEAS_DISCORD_USERNAME=Athena
ATHENA_IDEAS_DISCORD_CHANNEL=discord
ATHENA_IDEAS_DISCORD_TARGET=channel:YOUR_DISCORD_CHANNEL_ID
ATHENA_IDEAS_OPENCLAW_PROFILE=
ATHENA_APPROVAL_CHANNEL=discord
ATHENA_APPROVAL_TARGET=channel:YOUR_DISCORD_CHANNEL_ID
ATHENA_DISCORD_GUILD_ID=YOUR_ATHENA_DISCORD_SERVER_ID
ATHENA_DISCORD_APPROVAL_TARGET=
ATHENA_TRANSCRIPT_EMAIL_TO=
ATHENA_TRANSCRIPT_EMAIL_DELAY_SECONDS=45

# Optional connector webhooks
GOOGLE_CALENDAR_TOOL_URL=
GOOGLE_CALENDAR_TOOL_URL_BEARER=
GMAIL_TOOL_URL=
GMAIL_TOOL_URL_BEARER=
