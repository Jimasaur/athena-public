<% content_for(:title, "Athena Use Cases | Voice Ops Control") %>

<section class="border-b border-[#dfe5dc] bg-[#f7f7f2]">
  <div class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6">
    <nav class="flex flex-wrap items-center justify-between gap-4 text-sm">
      <%= link_to root_path, class: "flex items-center gap-3" do %>
        <%= image_tag "athena-logo.svg", class: "h-10 w-auto", alt: "Athena" %>
      <% end %>
      <div class="flex flex-wrap items-center gap-4 font-medium text-[#66716d]">
        <%= link_to "Use cases", use_cases_path, class: "text-[#182023]" %>
        <%= link_to "Dashboard", admin_root_path, class: "hover:text-[#182023]" %>
        <%= link_to "Console", admin_conversations_path, class: "inline-flex items-center gap-2 rounded-sm border border-[#0f766e] px-3 py-1.5 font-semibold text-[#0f766e] hover:bg-[#e8f3ef]" %>
      </div>
    </nav>
  </div>
</section>

<section class="bg-[#f7f7f2]">
  <div class="mx-auto w-full max-w-6xl px-4 pb-14 pt-12 sm:px-6">
    <p class="brand-kicker">Use case portfolio</p>
    <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-tight text-[#182023] md:text-6xl">
      Four paths for retreat-ready revenue cycle ideas.
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-[#4f5d58]">
      Athena turns phone conversations into structured improvement cards, sidecar notes, Discord reports, and a reviewable idea library.
    </p>

    <div class="mt-10 grid gap-3 border-y border-[#dfe5dc] py-5 md:grid-cols-4">
      <% [
        ["Focus", "Rev Cycle"],
        ["Project pages", @use_cases.count],
        ["Voice track", "OpenAI Realtime"],
        ["Common spine", "Idea cards"]
      ].each do |label, value| %>
        <div>
          <p class="text-xs font-semibold uppercase text-[#8a9690]"><%= label %></p>
          <p class="mt-2 text-xl font-semibold text-[#182023]"><%= value %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-[#fffffb]">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      <% @use_cases.each do |use_case| %>
        <%= link_to use_case_path(use_case[:slug]), class: "group brand-panel rounded-sm p-6 transition hover:-translate-y-0.5 hover:border-[#0f766e]" do %>
          <div class="flex items-start justify-between gap-4">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-sm border border-[#bfddd6] bg-[#e8f3ef] text-[#0f766e]">
              <i class="ti ti-<%= use_case[:icon] %> text-2xl"></i>
            </span>
            <span class="rounded-sm border border-[#dfe5dc] bg-[#f7f7f2] px-2.5 py-1 text-xs font-medium text-[#66716d]"><%= use_case[:space] %></span>
          </div>
          <p class="mt-5 text-xs font-semibold uppercase text-[#8a9690]"><%= use_case[:transport] %></p>
          <h2 class="mt-3 text-xl font-semibold text-[#182023]"><%= use_case[:short_title] %></h2>
          <p class="mt-3 min-h-24 text-sm leading-6 text-[#66716d]"><%= use_case[:summary] %></p>
          <div class="mt-6 flex items-center justify-between border-t border-[#dfe5dc] pt-4 text-sm">
            <span class="font-medium text-[#66716d]"><%= use_case[:user_stories].count %> stories</span>
            <span class="inline-flex items-center gap-1 font-semibold text-[#0f766e]">
              Explore
              <i class="ti ti-arrow-right transition group-hover:translate-x-0.5"></i>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="border-t border-[#dfe5dc] bg-[#f7f7f2]">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div>
      <p class="brand-kicker">Shared architecture</p>
      <h2 class="mt-3 text-3xl font-semibold text-[#182023]">One control plane, one voice track.</h2>
      <p class="mt-4 leading-7 text-[#4f5d58]">
        Athena keeps the durable record while OpenAI Realtime handles the live speech loop. Sidecars observe calls, update compact state, and create summaries, alerts, and drafts.
      </p>
    </div>
    <div class="grid gap-3">
      <% ["Twilio call", "Voice provider", "Athena state", "Sidecar observers", "Reviewed action"].each_with_index do |step, index| %>
        <div class="flex items-center gap-4 border-l-2 border-[#0f766e] bg-[#fffffb] px-4 py-3">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-[#111718] text-sm font-semibold text-[#c8d94a]"><%= index + 1 %></span>
          <span class="font-medium text-[#182023]"><%= step %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>
