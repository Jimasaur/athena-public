<%= render "admin/shared/page_header",
  title: "Idea library",
  subtitle: "Find, review, and export conversation-backed improvement ideas",
  right_class: "flex flex-wrap items-center gap-2 text-xs text-[#66716d]" do %>
  <span class="rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-3 py-2 font-semibold"><%= pluralize(@total_count, "idea") %> in library</span>
  <%= link_to admin_idea_captures_path(@filters.merge(format: :csv)), class: "inline-flex items-center gap-2 rounded-sm border border-[#bfddd6] bg-[#e8f3ef] px-3 py-2 text-sm font-semibold text-[#0f766e] hover:bg-[#eef7f4]" do %>
    <%= tabler_icon("download", size: 16) %>
    Export matching ideas
  <% end %>
<% end %>

<section class="brand-panel mb-5 rounded-sm p-5" aria-label="Filter ideas">
  <%= form_with url: admin_idea_captures_path, method: :get, class: "grid gap-4 md:grid-cols-[minmax(0,2fr)_1fr_1fr_auto] md:items-end" do %>
    <div>
      <%= label_tag :q, "Search ideas", class: "block text-xs font-semibold text-[#33413d]" %>
      <%= search_field_tag :q, @query, maxlength: 200, placeholder: "Problem, solution, impact, or department", class: "mt-2 w-full rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :category, "Category", class: "block text-xs font-semibold text-[#33413d]" %>
      <%= select_tag :category, options_for_select([["All categories", ""]] + @categories.map { |category| [category, category] }, @category), class: "mt-2 w-full rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :status, "Review status", class: "block text-xs font-semibold text-[#33413d]" %>
      <%= select_tag :status, options_for_select([["All statuses", ""]] + IdeaCapture::STATUSES.map { |status| [status.humanize, status] }, @status), class: "mt-2 w-full rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-3 py-2 text-sm" %>
    </div>
    <%= submit_tag "Apply filters", name: nil, class: "brand-primary-action rounded-sm border px-4 py-2 text-sm font-semibold" %>
  <% end %>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-[#66716d]">
    <p><%= @filtered_count %> matching of <%= @total_count %> total. CSV includes all matching ideas.</p>
    <% if @filters.any? %>
      <%= link_to "Clear filters", admin_idea_captures_path, class: "font-semibold text-[#0f766e] underline" %>
    <% end %>
  </div>
</section>

<section class="brand-panel rounded-sm">
  <% if @idea_captures.any? %>
    <div class="border-b border-[#dfe5dc] px-6 py-3 text-xs text-[#66716d]">
      Showing <%= @first_result %>–<%= @last_result %> of <%= @filtered_count %> matching ideas · newest first
    </div>
    <div class="divide-y divide-[#dfe5dc]">
      <% @idea_captures.each do |idea| %>
        <%= link_to admin_idea_capture_path(idea), class: "block px-6 py-5 hover:bg-[#eef7f4]", data: { idea_id: idea.id } do %>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-[#182023]"><%= idea.title %></p>
              <p class="mt-1 text-xs text-[#66716d]">
                <%= idea.category.presence || "Uncategorized" %> ·
                <%= idea.department.presence || "Department not captured" %> ·
                <%= idea.caller_name %>
              </p>
            </div>
            <span class="rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-2.5 py-1 text-xs font-semibold text-[#33413d]"><%= idea.status.humanize %></span>
          </div>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[#4f5d58]"><%= idea.problem.to_s.truncate(240) %></p>
          <p class="mt-2 text-xs text-[#66716d]">Captured <%= l(idea.created_at, format: :short) %> · Conversation #<%= idea.conversation_id %></p>
        <% end %>
      <% end %>
    </div>
    <% if @total_pages > 1 %>
      <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-[#dfe5dc] px-6 py-4 text-sm" aria-label="Idea library pages">
        <p class="text-[#66716d]">Page <%= @page %> of <%= @total_pages %></p>
        <div class="flex items-center gap-4 font-semibold text-[#0f766e]">
          <% if @page > 1 %>
            <%= link_to "Previous", admin_idea_captures_path(@filters.merge(page: @page - 1)), rel: "prev" %>
          <% end %>
          <% if @page < @total_pages %>
            <%= link_to "Next", admin_idea_captures_path(@filters.merge(page: @page + 1)), rel: "next" %>
          <% end %>
        </div>
      </nav>
    <% end %>
  <% else %>
    <div class="px-6 py-10">
      <% if @total_count.zero? %>
        <h2 class="font-semibold text-[#182023]">Build your idea library</h2>
        <p class="mt-2 text-sm leading-6 text-[#66716d]">Explore synthetic demo scenarios, then open an idea card to review its problem, impact hypothesis, and source conversation.</p>
        <%= link_to "Explore demo scenarios", admin_demo_scenarios_path, class: "mt-4 inline-block text-sm font-semibold text-[#0f766e] underline" %>
      <% else %>
        <h2 class="font-semibold text-[#182023]">No ideas match these filters</h2>
        <p class="mt-2 text-sm text-[#66716d]">Try a broader search or clear the category and status filters.</p>
        <%= link_to "Show all ideas", admin_idea_captures_path, class: "mt-4 inline-block text-sm font-semibold text-[#0f766e] underline" %>
      <% end %>
    </div>
  <% end %>
</section>
