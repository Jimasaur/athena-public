<%= render "admin/shared/page_header",
  title: "Idea Captures",
  subtitle: "Revenue cycle ideas captured by Athena for retreat review",
  right_class: "flex items-center gap-2 text-xs text-[#66716d]" do %>
  <span class="rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-3 py-2 font-semibold"><%= @idea_captures.count %> ideas</span>
<% end %>

<section class="brand-panel rounded-sm">
  <% if @idea_captures.any? %>
    <div class="divide-y divide-[#dfe5dc]">
      <% @idea_captures.each do |idea| %>
        <%= link_to admin_idea_capture_path(idea), class: "block px-6 py-5 hover:bg-[#eef7f4]" do %>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-[#182023]"><%= idea.title %></p>
              <p class="mt-1 text-xs text-[#66716d]">
                <%= idea.category.presence || "Uncategorized" %> ·
                <%= idea.department.presence || "Revenue Cycle" %> ·
                <%= idea.conversation.customer&.name.presence || "Unknown caller" %>
              </p>
            </div>
            <span class="rounded-sm border border-[#bfddd6] bg-[#e8f3ef] px-2.5 py-1 text-xs font-semibold text-[#0f766e]"><%= idea.status %></span>
          </div>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-[#4f5d58]"><%= idea.problem.to_s.truncate(240) %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="px-6 py-8 text-sm text-[#66716d]">No ideas captured yet. Place a test call and ask Athena to capture a revenue cycle improvement idea.</p>
  <% end %>
</section>
