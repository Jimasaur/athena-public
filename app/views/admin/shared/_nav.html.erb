<header class="console-header">
  <div class="console-nav-inner">
    <%= link_to root_path, class: "console-brand", aria: { label: "Athena home" } do %>
      <%= image_tag "athena-logo.svg", class: "h-10 w-auto", alt: "Athena" %>
    <% end %>
    <nav aria-label="Workspace navigation" class="console-nav-links">
      <% [
        ["Work queue", admin_root_path, "work_items"],
        ["Conversations", admin_conversations_path, "conversations"],
        ["Ideas", admin_idea_captures_path, "idea_captures"],
        ["Contacts", admin_customers_path, "customers"],
        ["Voice profiles", admin_agent_settings_path, "agent_settings"],
        ["Connections", admin_app_settings_path, "app_settings"]
      ].each do |label, path, section| %>
        <% active = controller_name == section || (section == "work_items" && controller_name == "work_item_handoffs") %>
        <%= link_to label, path, class: ["console-nav-link", ("is-active" if active)], aria: { current: ("page" if active) } %>
      <% end %>
    </nav>
  </div>
</header>
