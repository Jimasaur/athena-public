<%= form_with model: [:admin, @customer], class: "space-y-6" do |form| %>
  <% if @customer.errors.any? %>
    <div class="rounded-sm border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, class: "text-sm font-medium text-slate-700" %>
      <%= form.text_field :name, class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
    </div>
    <div>
      <%= form.label :greeting_name, "Greeting name", class: "text-sm font-medium text-slate-700" %>
      <%= form.text_field :greeting_name, class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :phone_number, "Phone number", class: "text-sm font-medium text-slate-700" %>
      <%= form.telephone_field :phone_number, class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.fields_for :metadata do |metadata_fields| %>
        <%= metadata_fields.label :company, class: "text-sm font-medium text-slate-700" %>
        <%= metadata_fields.text_field :company, value: @customer.metadata["company"], class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
      <% end %>
    </div>
    <div>
      <%= form.fields_for :metadata do |metadata_fields| %>
        <%= metadata_fields.label :plan, class: "text-sm font-medium text-slate-700" %>
        <%= metadata_fields.text_field :plan, value: @customer.metadata["plan"], class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.label :customer_portrait, "Patient portrait (markdown)", class: "text-sm font-medium text-slate-700" %>
    <%= form.text_area :customer_portrait, rows: 6, class: "mt-2 w-full rounded-sm border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-orange-200 focus:outline-none focus:ring-2 focus:ring-orange-100" %>
    <p class="mt-2 text-xs text-slate-500">Used to personalize calls.</p>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-sm border border-slate-200 bg-slate-900 px-5 py-2 text-sm font-medium text-white hover:bg-slate-800" %>
    <%= link_to "Cancel", admin_customers_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  </div>
<% end %>
