<% content_for(:title, "Athena | Reviewed operational work") %>

<section class="bg-[#f7f7f2]">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div>
      <p class="brand-kicker">Operational work, ready for review</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-tight text-[#182023] md:text-6xl">
        Turn conversations into work your team can finish.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#4f5d58]">
        Capture incoming requests, preserve their context, assign the next step, and keep decisions and handoffs visible. Athena gives your team one place to review operational work.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to admin_root_path, class: "brand-primary-action inline-flex items-center gap-2 rounded-sm border px-4 py-2 text-sm font-semibold shadow-sm" do %>
          <i aria-hidden="true" class="ti ti-dashboard"></i>
          Open work queue
        <% end %>
        <%= link_to new_admin_work_item_path, class: "inline-flex items-center gap-2 rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-4 py-2 text-sm font-semibold text-[#182023] shadow-sm hover:bg-[#f0f3ed]" do %>
          <i aria-hidden="true" class="ti ti-layout-grid"></i>
          Capture a request
        <% end %>
      </div>
      <p class="mt-5 max-w-xl text-sm leading-6 text-[#66716d]">Development prototype. Explore with synthetic requests. Connected handoffs require configuration and explicit review.</p>
    </div>

    <div class="brand-panel overflow-hidden rounded-sm">
      <div class="border-b border-[#dfe5dc] px-5 py-4">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-semibold text-[#182023]">From request to a clear next step</p>
            <p class="text-xs text-[#66716d]">Illustrative scenario · synthetic caller</p>
          </div>
          <span class="rounded-sm border border-[#d95f54]/30 bg-[#d95f54]/10 px-2 py-1 text-xs font-semibold text-[#9d332c]">Needs review</span>
        </div>
      </div>
      <div class="grid gap-3 p-5">
        <% [
          ["Structured request", "Keep the problem, context, and proposed next step together.", "ti-route", "text-[#0f766e]"],
          ["Clear ownership", "Assign an owner and due date, then track progress.", "ti-user-check", "text-[#6554c0]"],
          ["Reviewed handoff", "Inspect the saved payload and approve the specific next action.", "ti-message-2", "text-[#d95f54]"],
          ["Visible outcome", "Record delivery separately from work resolution.", "ti-shield-check", "text-[#0f766e]"]
        ].each do |title, detail, icon, color| %>
          <div class="flex gap-3 rounded-sm border border-[#dfe5dc] bg-[#fffffb] p-4">
            <i aria-hidden="true" class="ti <%= icon %> mt-0.5 text-xl <%= color %>"></i>
            <div>
              <p class="text-sm font-semibold text-[#182023]"><%= title %></p>
              <p class="mt-1 text-sm leading-5 text-[#66716d]"><%= detail %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
<section class="border-y border-[#dfe5dc] bg-[#fffffb]">
  <div class="mx-auto grid w-full max-w-6xl gap-5 px-4 py-8 sm:px-6 md:grid-cols-4">
    <% [
      ["Intake", "Staff requests · voice ideas"],
      ["Coordination", "Owner · due date · next step"],
      ["Handoff", "Prepare · review · deliver"],
      ["Outcome", "Evidence · resolution note"]
    ].each do |label, value| %>
      <div>
        <p class="text-xs font-semibold uppercase text-[#8a9690]"><%= label %></p>
        <p class="mt-2 text-lg font-semibold text-[#182023]"><%= value %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="bg-[#f7f7f2]">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <p class="brand-kicker">Operational pattern</p>
      <h2 class="mt-3 text-3xl font-semibold text-[#182023]">Keep the context. Make the next step clear.</h2>
      <p class="mt-4 leading-7 text-[#4f5d58]">
        Voice conversations and staff web intake feed a shared work queue. Requests, issues, improvement opportunities, and follow-ups stay connected to their source and the decisions made along the way.
      </p>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-5">
      <% ["Capture", "Clarify", "Assign", "Review", "Follow through"].each_with_index do |step, index| %>
        <div class="brand-panel rounded-sm p-4">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-[#111718] text-sm font-semibold text-[#c8d94a]"><%= index + 1 %></span>
          <p class="mt-4 text-sm font-semibold text-[#182023]"><%= step %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-[#fffffb]">
  <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-16 sm:px-6 lg:grid-cols-3">
    <% [
      ["Operational intake", "Capture a reporting request, a service issue, or a recurring process problem without losing its context.", "ti-inbox"],
      ["Coordinated work", "See what needs review, what has no owner, and what is overdue. Keep the next step visible.", "ti-list-check"],
      ["Reviewable handoffs", "Prepare an approved payload for your downstream system and retain the delivery result.", "ti-arrows-exchange"]
    ].each do |title, detail, icon| %>
      <div class="brand-panel rounded-sm p-6">
        <i aria-hidden="true" class="ti <%= icon %> text-2xl text-[#0f766e]"></i>
        <h3 class="mt-5 text-xl font-semibold text-[#182023]"><%= title %></h3>
        <p class="mt-3 text-sm leading-6 text-[#66716d]"><%= detail %></p>
      </div>
    <% end %>
  </div>
</section>
