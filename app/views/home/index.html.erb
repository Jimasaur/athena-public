<% content_for(:title, "Athena | Voice Ops Control") %>

<section class="border-b border-[#dfe5dc] bg-[#f7f7f2]">
  <div class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6">
    <nav class="flex flex-wrap items-center justify-between gap-4 text-sm">
      <%= link_to root_path, class: "flex items-center gap-3" do %>
        <%= image_tag "athena-logo.svg", class: "h-10 w-auto", alt: "Athena" %>
      <% end %>
      <div class="flex flex-wrap items-center gap-4 font-medium text-[#66716d]">
        <%= link_to "Use cases", use_cases_path, class: "hover:text-[#182023]" %>
        <%= link_to "Demo", admin_root_path, class: "hover:text-[#182023]" %>
        <%= link_to "Console", admin_conversations_path, class: "inline-flex items-center gap-2 rounded-sm border border-[#0f766e] px-3 py-1.5 font-semibold text-[#0f766e] hover:bg-[#e8f3ef]" %>
      </div>
    </nav>
  </div>
</section>

<section class="bg-[#f7f7f2]">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div>
      <p class="brand-kicker">Revenue cycle ideation line</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-tight text-[#182023] md:text-6xl">
        Turn rough improvement ideas into retreat-ready insight cards.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#4f5d58]">
        Athena gives revenue cycle teams a phone-based thought partner for automation, innovation, cost savings, and workflow ideas before the retreat.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to admin_root_path, class: "brand-primary-action inline-flex items-center gap-2 rounded-sm border px-4 py-2 text-sm font-semibold shadow-sm" do %>
          <i class="ti ti-dashboard"></i>
          Open demo cockpit
        <% end %>
        <%= link_to use_cases_path, class: "inline-flex items-center gap-2 rounded-sm border border-[#dfe5dc] bg-[#fffffb] px-4 py-2 text-sm font-semibold text-[#182023] shadow-sm hover:bg-[#f0f3ed]" do %>
          <i class="ti ti-layout-grid"></i>
          View use cases
        <% end %>
      </div>
    </div>

    <div class="brand-panel overflow-hidden rounded-sm">
      <div class="border-b border-[#dfe5dc] px-5 py-4">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-semibold text-[#182023]">Live idea capture</p>
            <p class="text-xs text-[#66716d]">Dana Miller · rev cycle retreat</p>
          </div>
          <span class="rounded-sm border border-[#d95f54]/30 bg-[#d95f54]/10 px-2 py-1 text-xs font-semibold text-[#9d332c]">Needs review</span>
        </div>
      </div>
      <div class="grid gap-3 p-5">
        <% [
          ["Call state", "Intent: rev cycle ideation · Risk: low", "ti-route", "text-[#0f766e]"],
          ["Idea card", "Problem, proposed solution, impact, and next step are captured.", "ti-bulb", "text-[#6554c0]"],
          ["Discord report", "The retreat channel gets a concise summary for testing.", "ti-message-2", "text-[#d95f54]"],
          ["Evidence trail", "Transcript, state, and sidecar events stay linked.", "ti-shield-check", "text-[#0f766e]"]
        ].each do |title, detail, icon, color| %>
          <div class="flex gap-3 rounded-sm border border-[#dfe5dc] bg-[#fffffb] p-4">
            <i class="ti <%= icon %> mt-0.5 text-xl <%= color %>"></i>
            <div>
              <p class="text-sm font-semibold text-[#182023]"><%= title %></p>
              <p class="mt-1 text-sm leading-5 text-[#66716d]"><%= detail %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="border-y border-[#dfe5dc] bg-[#fffffb]">
  <div class="mx-auto grid w-full max-w-6xl gap-5 px-4 py-8 sm:px-6 md:grid-cols-4">
    <% [
      ["Provider", "Twilio · OpenAI Realtime"],
      ["Core record", "Contacts · calls · transcripts"],
      ["Sidecars", "State · summaries · drafts"],
      ["Guardrails", "Approval · opt-out · audit"]
    ].each do |label, value| %>
      <div>
        <p class="text-xs font-semibold uppercase text-[#8a9690]"><%= label %></p>
        <p class="mt-2 text-lg font-semibold text-[#182023]"><%= value %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="bg-[#f7f7f2]">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <p class="brand-kicker">Operational pattern</p>
      <h2 class="mt-3 text-3xl font-semibold text-[#182023]">One chain for every pilot.</h2>
      <p class="mt-4 leading-7 text-[#4f5d58]">
        Athena uses one simple chain: capture a conversation, maintain state, let sidecars structure the idea, then make it reviewable for the workshop team.
      </p>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-5">
      <% ["Call", "Transcript", "Call state", "Idea card", "Review library"].each_with_index do |step, index| %>
        <div class="brand-panel rounded-sm p-4">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-[#111718] text-sm font-semibold text-[#c8d94a]"><%= index + 1 %></span>
          <p class="mt-4 text-sm font-semibold text-[#182023]"><%= step %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-[#fffffb]">
  <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-16 sm:px-6 lg:grid-cols-3">
    <% [
      ["Ideation calls", "Help staff shape rough thoughts into clearer retreat discussion prompts.", "ti-bulb"],
      ["Automation discovery", "Capture repeated manual work, workflow triggers, systems, and pilot questions.", "ti-robot"],
      ["Workshop review", "Give facilitators an organized idea library with transcript-backed evidence.", "ti-folders"]
    ].each do |title, detail, icon| %>
      <div class="brand-panel rounded-sm p-6">
        <i class="ti <%= icon %> text-2xl text-[#0f766e]"></i>
        <h3 class="mt-5 text-xl font-semibold text-[#182023]"><%= title %></h3>
        <p class="mt-3 text-sm leading-6 text-[#66716d]"><%= detail %></p>
      </div>
    <% end %>
  </div>
</section>
