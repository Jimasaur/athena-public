<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Athena" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Athena">
    <meta name="description" content="Athena turns conversations and incoming requests into structured work, clear ownership, reviewed handoffs, and visible outcomes. Explore the development prototype with synthetic data.">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#f7f7f2] text-[#182023] antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-3">Skip to content</a>
    <%= render "shared/marketing_nav" %>
    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="border-t border-[#dfe5dc] px-4 py-8 text-sm text-[#66716d] sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
        <p>Built for exploration with synthetic data. Human review remains part of the workflow.</p>
        <%= link_to "Explore the source on GitHub", "https://github.com/Jimasaur/athena-public", class: "font-semibold text-[#0f766e] underline underline-offset-4" %>
      </div>
    </footer>
  </body>
</html>
